# ---- General ----
ENV=development

# ---- Core Engine (Java / Spring Boot) ----
CORE_ENGINE_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SQLITE_DB_PATH=./data/control-plane.db
JWT_SECRET=changeme-generate-a-real-secret
API_KEY_HASH_SALT=changeme-generate-a-real-salt

# ---- ClickHouse ----
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=ulpf
CLICKHOUSE_USER=ulpf_app
CLICKHOUSE_PASSWORD=changeme

# ---- Analytics Service (Python / FastAPI) ----
ANALYTICS_SERVICE_PORT=8000
# Deliberately a SEPARATE, read-only ClickHouse user — never reuse ulpf_app here
ANALYTICS_CLICKHOUSE_USER=ulpf_readonly
ANALYTICS_CLICKHOUSE_PASSWORD=changeme

# ---- Frontend ----
VITE_CORE_ENGINE_API_URL=http://localhost:8080
VITE_ANALYTICS_API_URL=http://localhost:8000