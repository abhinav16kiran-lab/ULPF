# ==============================================================================
# ULPF (Universal Log Processing Framework) Environment Configuration
# ==============================================================================

# ---- General ----
ENV=development

# ---- One-time Setup Credentials ----
# Entered once on the setup screen (http://localhost:3000/setup) to prove you control this server, before you
# create the super-admin account. They are not a login and are never used again after setup.
# startup/start.sh fills ULPF_ADMIN_PASSWORD with a random value when it creates .env. Blank = setup disabled.
ULPF_ADMIN_USERNAME=setup
ULPF_ADMIN_PASSWORD=

# ---- Core Engine (Java 21 / Spring Boot) ----
CORE_ENGINE_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SQLITE_DB_PATH=./data/control-plane.db
JWT_SECRET=super-secret-jwt-signing-key-for-ulpf-dev-12345
API_KEY_HASH_SALT=dev-salt-key-for-api-hash-12345

# ---- ClickHouse Storage Engine ----
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=ulpf_raw
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=Clickhouse123!
CLICKHOUSE_URL=jdbc:clickhouse:http://host.containers.internal:8123/ulpf_raw?compress=0&user=default&password=Clickhouse123!

# ---- Frontend ----
VITE_CORE_ENGINE_API_URL=http://localhost:8080

# ---- External Alert Webhook (Optional, e.g. Slack / Teams / PagerDuty) ----
# ULPF_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ULPF_ALERT_WEBHOOK_SECRET=your-webhook-hmac-sha256-secret

# ---- Ingestion Failure & Drift Notification Throttling ----
# ULPF_TABLE_FAILURE_COOLDOWN_MS=1800000
# ULPF_TABLE_FAILURE_RECOVERY_QUIET_MS=300000
# ULPF_TABLE_FAILURE_REPLAY_MARGIN_MIN=5
# ULPF_SCHEMA_DRIFT_COOLDOWN_MS=1800000