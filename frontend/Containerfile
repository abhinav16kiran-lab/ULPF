# Stage 1: Build React application with Node.js 20 LTS (Iron) on Alpine 3.21
FROM docker.io/library/node:20-alpine3.21 AS builder

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code and build production distribution
COPY . .
ARG VITE_CORE_ENGINE_API_URL=""
ENV VITE_CORE_ENGINE_API_URL=${VITE_CORE_ENGINE_API_URL}
RUN npm run build

# Stage 2: Serve static bundle via stable Nginx on Alpine
FROM docker.io/library/nginx:1.26-alpine AS runner

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy production static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
